# Salin file ini menjadi ".env" lalu isi dari Supabase Dashboard → Project Settings → API.
# Kosongkan keduanya untuk memakai data awal (src/data/default.ts) tanpa database.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# JANGAN pernah menaruh "service_role" key di sini atau di repo.
# Formulir kontak: kunci acak panjang (mis. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# Isi juga di Vercel (Environment Variables) dan simpan hash SHA-256-nya di Supabase — lihat README bagian Formulir kontak.
CONTACT_SECRET=
