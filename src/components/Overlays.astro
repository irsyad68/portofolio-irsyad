---
/* Popup project, lightbox foto, toast, tombol kembali ke atas */
import Icon from "./Icon.astro";
---
<button id="toTop" data-i18n-aria="ui.top" aria-label="Back to top" class="fixed right-5 bottom-6 z-40 grid size-12 translate-y-2.5 place-items-center rounded-full border border-line bg-card opacity-0 shadow-soft transition-all duration-300 invisible hover:bg-inv hover:text-on-inv [&.show]:visible [&.show]:translate-y-0 [&.show]:opacity-100"><Icon name="arrowUp" /></button>

<div class="modal fixed inset-0 z-90 grid place-items-center bg-[rgba(9,9,11,.45)] p-4 backdrop-blur-sm max-sm:place-items-end max-sm:p-0" id="modal" role="dialog" aria-modal="true" aria-labelledby="mTitle">
  <div class="modal-box relative max-h-[calc(100dvh-2rem)] w-full max-w-190 overflow-auto overscroll-contain rounded-3xl border border-line bg-card shadow-big max-sm:max-h-[92dvh] max-sm:rounded-b-none" id="modalBox">
    <button class="absolute top-3.5 right-3.5 z-4 grid size-11 place-items-center rounded-full border border-line bg-card shadow-soft" id="mClose" data-i18n-aria="ui.close" aria-label="Close"><Icon name="x" /></button>
    <div id="modalContent"></div>
  </div>
</div>

<div class="lb fixed inset-0 z-95 touch-pan-y bg-[rgba(9,9,11,.92)]" id="lb" role="dialog" aria-modal="true" aria-label="Photo viewer">
  <div class="lb-stage absolute inset-0 grid place-items-center px-18 pt-18 pb-8 max-sm:px-3 max-sm:pb-24">
    <figure class="flex max-h-full max-w-full flex-col items-center gap-3.5">
      <img id="lbImg" alt="" class="max-h-[calc(100dvh-10rem)] max-w-[min(68rem,100%)] rounded-xl bg-[#18181B] object-contain" />
      <figcaption id="lbCap" class="flex flex-wrap items-baseline justify-center gap-4 text-center text-[0.9062rem] text-[#E4E4E7]"></figcaption>
    </figure>
  </div>
  <button class="absolute top-4 right-4 grid size-12 place-items-center rounded-full border border-white/20 bg-white/10 text-[#FAFAFA] hover:bg-white/20" id="lbClose" data-i18n-aria="ui.closePhoto" aria-label="Close photo"><Icon name="x" size={20} /></button>
  <button class="absolute top-1/2 left-4 grid size-12 -translate-y-1/2 place-items-center rounded-full border border-white/20 bg-white/10 text-[#FAFAFA] hover:bg-white/20 max-sm:top-auto max-sm:bottom-5 max-sm:left-[calc(50%-3.75rem)] max-sm:translate-y-0" id="lbPrev" data-i18n-aria="ui.prevPhoto" aria-label="Previous photo"><Icon name="chevronLeft" size={22} /></button>
  <button class="absolute top-1/2 right-4 grid size-12 -translate-y-1/2 place-items-center rounded-full border border-white/20 bg-white/10 text-[#FAFAFA] hover:bg-white/20 max-sm:top-auto max-sm:right-[calc(50%-3.75rem)] max-sm:bottom-5 max-sm:translate-y-0" id="lbNext" data-i18n-aria="ui.nextPhoto" aria-label="Next photo"><Icon name="chevronRight" size={22} /></button>
</div>

<div class="toast fixed bottom-6 left-1/2 z-99 flex max-w-[calc(100vw-2rem)] items-center gap-2 rounded-full bg-inv px-4.5 py-3 text-sm font-semibold text-on-inv shadow-big" id="toast" role="status" aria-live="polite"></div>
