---
import Icon from "./Icon.astro";
import T from "./T.astro";
import SectionHead from "./SectionHead.astro";
import { photosOf, safeUrl, pad2 } from "../lib/format";
import type { Project } from "../lib/types";
interface Props { projects: Project[] }
const ps = Astro.props.projects.filter(p => p.pub !== false);
const cats = ["All", ...new Set(ps.map(p => p.c))];
const count = (c: string) => (c === "All" ? ps.length : ps.filter(p => p.c === c).length);
---
<section id="projects" class="border-t border-line py-27.5 max-lg:py-20">
  <div class="mx-auto grid max-w-300 gap-10 px-6 max-lg:gap-7">
    <SectionHead idx="04" k="proj" />
    <div class="min-w-0">
      <div class="reveal mb-4 flex flex-wrap items-center justify-between gap-3">
        <div class="seg relative inline-flex max-w-full min-w-0 gap-0.5 overflow-x-auto rounded-full bg-muted p-1" role="tablist" aria-label="Project category" data-seg="proj">
          <span class="seg-pill" aria-hidden="true"></span>
          {cats.map((c, i) => <button role="tab" aria-selected={i === 0 ? "true" : "false"} data-v={c} class="relative z-1 min-h-11 rounded-full px-4 text-sm font-semibold whitespace-nowrap text-fg-muted transition-colors">{c === "All" ? <T k="proj.all" /> : c}<span class="ml-1.25 text-xs font-medium text-fg-muted">{count(c)}</span></button>)}
        </div>
        <label class="flex min-h-11 flex-[0_1_16.25rem] items-center gap-2 rounded-full border border-line bg-card px-4 text-fg-muted transition-colors focus-within:border-accent max-sm:flex-[1_1_100%]">
          <Icon name="search" size={16} /><input id="pSearch" type="search" data-i18n-ph="proj.search" data-i18n-aria="proj.search" placeholder="Search projects or methods" aria-label="Search projects" class="w-full min-w-0 bg-transparent text-[0.9062rem] text-fg outline-none" />
        </label>
      </div>
      <!-- daftar project bergaya indeks: baris terisi burgundy saat hover + pratinjau mengikuti kursor -->
      <div class="hidden grid-cols-[3.5rem_minmax(0,1fr)_9.5rem_4rem_2.75rem] gap-5 border-b border-line pb-3 md:grid" aria-hidden="true">
        <span class="label"><T k="proj.no" /></span><span class="label"><T k="proj.project" /></span><span class="label"><T k="proj.category" /></span><span class="label"><T k="proj.year" /></span><span></span>
      </div>
      <div id="pGrid" aria-live="polite">
        {ps.map((p, i) => {
          const ph = photosOf(p);
          return (
            <article class="p-card p-row relative grid grid-cols-[3.5rem_minmax(0,1fr)_9.5rem_4rem_2.75rem] items-center gap-5 border-b border-line py-6.5 max-md:grid-cols-[2.25rem_minmax(0,1fr)_2.75rem] max-md:items-start max-md:gap-3 max-md:py-5"
              data-cat={p.c} data-search={`${p.t} ${p.s} ${p.tr.s ?? ""} ${p.tags.join(" ")}`.toLowerCase()} style={`animation-delay:${i * 50}ms`}>
              <span class="p-num font-head text-[1.75rem] leading-none font-extrabold tracking-[-.04em] text-line-strong tabular-nums max-md:text-lg">{pad2(i)}</span>
              <div class="min-w-0">
                <h3 class="font-head text-[clamp(1.1875rem,2vw,1.625rem)] leading-tight font-bold tracking-[-.025em]">{p.t}</h3>
                <div class="p-muted mt-1 text-sm text-fg-muted"><T en={p.s} id={p.tr.s} /><span class="md:hidden"> · {p.c} · {p.y}</span></div>
                <div class="mt-3 flex flex-wrap gap-1.5">{p.tags.map(t => <span class="p-tag rounded-full bg-muted px-2.5 py-0.75 text-xs whitespace-nowrap text-fg-2">{t}</span>)}</div>
              </div>
              <span class="p-badge justify-self-start rounded-full bg-accent-soft px-2.5 py-1.25 text-xs font-semibold tracking-[.06em] text-accent uppercase max-md:hidden">{p.c}</span>
              <span class="p-muted text-sm text-fg-muted tabular-nums max-md:hidden">{p.y}</span>
              <span class="p-go grid size-11 place-items-center rounded-full border border-line transition-all duration-300" aria-hidden="true"><Icon name="arrowUpRight" size={18} /></span>
              <template class="p-src">{ph.length
                ? <img src={ph[0].src} alt="" decoding="async" class="size-full object-cover" />
                : <div class="grid size-full place-items-center bg-accent-soft text-accent"><Icon name={p.ic || "folder"} size={44} /></div>}</template>
              <button class="absolute inset-0 z-3 rounded-card focus-visible:outline-offset-[-3px]" data-project={p.id} aria-label={p.t}></button>
            </article>
          );
        })}
        <div id="pEmpty" class="rounded-card-lg border border-dashed border-line-strong px-5 py-14 text-center text-fg-muted" hidden><T k="proj.empty" /></div>
      </div>
    </div>
  </div>

  <!-- pratinjau project (satu elemen untuk semua baris, posisi fixed mengikuti kursor) -->
  <div id="projPrev" class="follow max-md:hidden" aria-hidden="true"><div class="follow-in aspect-[4/3] w-48 overflow-hidden rounded-card border border-line bg-card shadow-soft" data-slot="media"></div></div>

  <!-- isi popup tiap project (dirender di server, ditampilkan oleh skrip) -->
  {ps.map((p, i) => {
    const ph = photosOf(p), demo = safeUrl(p.demo), repo = safeUrl(p.repo);
    return (
      <template id={`pm-${p.id}`}>
        {ph.length
          ? <button class="block w-full cursor-zoom-in" data-gallery={`pj-${p.id}`} data-k="0" aria-label={p.t}>
              <div class="p-thumb has-img relative aspect-[21/9] overflow-hidden bg-muted max-sm:aspect-video"><img src={ph[0].src} alt={ph[0].caption || p.t} class="absolute inset-0 size-full object-cover" /><span class="absolute top-3.5 left-3.5 rounded-full border border-line bg-card px-2.5 py-1.25 text-xs font-semibold tracking-[.06em] uppercase">{p.c}</span></div>
            </button>
          : <div class="p-thumb relative grid aspect-[21/9] place-items-center overflow-hidden max-sm:aspect-video" aria-hidden="true">
              <span class="big absolute -right-1.5 -bottom-6 font-head text-[7rem] leading-none font-extrabold tracking-[-.06em]">{pad2(i)}</span>
              <span class="pic grid size-21 place-items-center rounded-[1.125rem] border"><Icon name={p.ic || "folder"} size={36} /></span>
              <span class="absolute top-3.5 left-3.5 rounded-full border border-line bg-card px-2.5 py-1.25 text-xs font-semibold tracking-[.06em] text-fg uppercase">{p.c}</span>
            </div>}
        <div class="p-7 max-sm:p-5.5">
          <div class="label tabular-nums">{p.y}</div>
          <h3 class="mt-1.5 font-head text-[1.625rem] leading-snug font-bold tracking-[-.02em] max-sm:text-[1.375rem]" data-title>{p.t}</h3>
          <div class="mt-1 text-[0.9375rem] text-fg-2"><T en={p.s} id={p.tr.s} /></div>
          <p class="mt-3.5 text-fg-2"><T en={p.d} id={p.tr.d} /></p>
          <div class="mt-4.5 flex flex-wrap gap-1.5">{p.tags.map(t => <span class="rounded-full bg-muted px-2.5 py-0.75 text-xs text-fg-2">{t}</span>)}</div>
          {ph.length > 1 && (
            <div class="mt-5.5"><div class="label"><T k="proj.docs" /> · {ph.length} <T k="proj.photos" /></div>
              <div class="mt-2.5 grid grid-cols-[repeat(auto-fill,minmax(5.5rem,1fr))] gap-2">
                {ph.map((x, k) => <button class="group aspect-[4/3] cursor-zoom-in overflow-hidden rounded-[0.625rem] border border-line bg-muted" data-gallery={`pj-${p.id}`} data-k={k} aria-label={`${k + 1} / ${ph.length}: ${x.caption || p.t}`}><img src={x.src} alt={x.caption || p.t} loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-400 group-hover:scale-108" /></button>)}
              </div>
            </div>
          )}
          {(demo || repo) && (
            <div class="mt-6 flex flex-wrap gap-3">
              {demo && <a class="btn btn-dark" href={demo} target="_blank" rel="noopener"><T k="proj.demo" /> <Icon name="external" size={16} /></a>}
              {repo && <a class="btn" href={repo} target="_blank" rel="noopener"><Icon name="github" size={16} /> <T k="proj.repo" /></a>}
            </div>
          )}
        </div>
      </template>
    );
  })}
</section>
